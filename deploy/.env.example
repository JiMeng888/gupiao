# ---------------------------------------------------------------------------
# 一键启动环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后编辑 .env，把下面带「必须改」的地方填上自己的值。
#
#   或者直接跑 start.sh / start.bat —— 脚本会自动从本模板生成 .env，
#   并在缺少 JWT_SECRET / MYSQL_ROOT_PASSWORD 时自动生成随机值。
#
# 注意：.env 已被 .gitignore 忽略，不会进 git，放心填真实值。
# ---------------------------------------------------------------------------

# ---------- 数据库（必须） ----------
# MySQL root 密码。生产环境务必改成强密码。
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 应用连接库的用户名（默认 root 即可；schema 脚本会为应用建专用账号并收权）
DB_USERNAME=root

# ---------- 鉴权（必须） ----------
# JWT 签名密钥，至少 32 字符的随机串。start 脚本会自动生成，也可手工指定。
# 注意：.env 里用 JWT_SECRET 这个易读名字，compose 会把它映射成后端真正读取的
# APP_JWT_SECRET（后端 application.yml 读的是 APP_JWT_SECRET，二者别搞混）。
# 生成示例：openssl rand -hex 32
JWT_SECRET=

# ---------- AI 分析（可选） ----------
# 不配则 AI 分析自动降级为规则引擎，并在响应里如实标注。
# 配了则走真实大模型。
# provider 可选：deepseek / qwen / openai / mock
# qwen（阿里云百炼/千问）的 base-url 留空即可，后端默认走
# https://dashscope.aliyuncs.com/compatible-mode；model 默认 qwen-plus。
# 注意：新密钥以 sk-ws- 开头（旧版为 sk-），均为合法格式。
LLM_PROVIDER=qwen
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_API_KEY=

# ---------- 端口（可选） ----------
# 前端入口（宿主端口 → 容器 80）。这是**唯一**对外需要开放的端口。
FRONTEND_PORT=8088
# 后端（宿主端口 → 容器 8080；默认 18080 避开 Docker Desktop 占用的宿主 8080）
# lite 编排把它绑在 127.0.0.1 上，公网访问不到，只供本机/SSH 隧道调试用。
BACKEND_PORT=18080
# MySQL（宿主端口 → 容器 3306，仅调试用；lite 编排不用这个变量）
# 公网主机上请把 docker-compose.yml 里 mysql 的 ports 整段删掉
MYSQL_PORT=3307

# ---------- 部署位置相关（部署到服务器时按需改） ----------
# 限流是否信任 X-Forwarded-For。
# 经 nginx 反代时必须为 true，否则所有用户共用 nginx 容器的一个桶，
# 严格桶 20 次/分钟会被几个人打满。前端 nginx.conf 已用 $remote_addr 覆盖该头，
# 客户端无法伪造取值。
# 只有在「后端直接暴露给公网、前面没有任何反代」时才应设为 false。
RATE_LIMIT_TRUST_FORWARDED=true

# 行情降级链顺序。东财有 IP 级风控，境外主机命中概率更高；
# 若页面显示的数据源频繁变成「演示数据」，改成 tencent,eastmoney,tushare 试试。
# 注意：腾讯没有全市场榜单与搜索能力，这两项会落到演示池。
MARKET_DATA_CHAIN=eastmoney,tencent,tushare

# ---------- lite 模式内存（仅 docker-compose.lite.yml 生效） ----------
# 后端 JVM 堆与容器上限。1 GB 机器建议改成 -Xmx320m / 640m。
# LITE_JAVA_OPTS=-Xmx448m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=192m
# LITE_BACKEND_MEM=768m

